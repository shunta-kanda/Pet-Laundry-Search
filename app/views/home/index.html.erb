<!-- app/views/home/index.html.erb -->
<div class="container my-5">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="fw-bold">ペットコインランドリー検索</h1>
      <p class="text-muted">ペットと一緒に行ける近くのコインランドリーを探そう！</p>
    </div>
  </div>

  <!-- エリア絞り込みプルダウン -->
  <div class="row mb-4">
    <div class="col-md-6 col-lg-4">
      <div class="card bg-light border-0 shadow-sm p-3">
        <%= form_with url: root_path, method: :get, local: true, class: "d-flex align-items-center gap-2" do %>
          <label for="area_id" class="form-label text-secondary fw-bold text-nowrap mb-0">
            <i class="bi bi-funnel-fill"></i> エリア:
          </label>
          <%= select_tag :area_id, 
              options_from_collection_for_select(@areas, :id, :name, params[:area_id]), 
              include_blank: "すべてのエリア", 
              class: "form-select form-select-sm", 
              onchange: "this.form.requestSubmit();" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 地図表示エリア -->
  <div class="row mb-5">
    <div class="col-12">
      <div id="map" style="height: 450px; width: 100%;" class="rounded shadow-sm border"></div>
    </div>
  </div>

  <!-- 店舗一覧エリア -->
  <div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <h2 class="h4 fw-bold mb-0">店舗一覧</h2>
      <span class="text-muted small">該当件数: <%= @shops.size %> 件</span>
    </div>
  </div>

  <% if @shops.any? %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @shops.each do |shop| %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <!-- エリア名タグ -->
                <% if shop.area.present? %>
                  <span class="badge bg-primary mb-2"><%= shop.area.name %></span>
                <% end %>

                <h3 class="card-title h5 fw-bold"><%= shop.name %></h3>
                <p class="card-text text-muted small mb-2">
                  <i class="bi bi-geo-alt-fill text-danger"></i> <%= shop.address %>
                </p>

                <% if shop.opening_hours.present? %>
                  <p class="card-text small mb-2">
                    <i class="bi bi-clock"></i> <%= shop.opening_hours %>
                  </p>
                <% end %>

                <p class="card-text small mb-3">
                  <% if shop.parking_available? %>
                    <span class="text-success fw-semibold"><i class="bi bi-car-front-fill"></i> 駐車場あり</span>
                  <% else %>
                    <span class="text-muted"><i class="bi bi-car-front"></i> 駐車場なし</span>
                  <% end %>
                </p>
              </div>

              <!-- リンク類 -->
              <div class="mt-auto pt-3 border-top d-flex gap-2">
                <% if shop.website_url.present? %>
                  <%= link_to "公式サイト", shop.website_url, target: "_blank", class: "btn btn-outline-primary btn-sm" %>
                <% end %>
                <% if shop.google_maps_url.present? %>
                  <%= link_to "Googleマップ", shop.google_maps_url, target: "_blank", class: "btn btn-outline-secondary btn-sm" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="row">
      <div class="col-12 text-center py-5">
        <p class="text-muted fs-5">該当する店舗が見つかりませんでした。</p>
        <%= link_to "すべての店舗を表示する", root_path, class: "btn btn-primary rounded-pill px-4" %>
      </div>
    </div>
  <% end %>
</div>

<!-- Leaflet 地図描画スクリプト -->
<script>
  function initMap() {
    if (typeof L === 'undefined') {
      setTimeout(initMap, 100);
      return;
    }

    const mapElement = document.getElementById('map');
    if (!mapElement) return;

    if (mapElement._leaflet_id) {
      mapElement._leaflet_id = null;
    }

    // 初期中心座標（福岡県）
    const defaultLat = 33.5902;
    const defaultLng = 130.4207;
    const map = L.map('map').setView([defaultLat, defaultLng], 11);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    const shops = <%= raw @shops.to_json(only: [:id, :name, :address, :latitude, :longitude, :opening_hours]) %>;
    const markers = [];

    shops.forEach(function(shop) {
      if (shop.latitude && shop.longitude) {
        const popupContent = `
          <strong>${shop.name}</strong><br>
          ${shop.address}<br>
          ${shop.opening_hours ? '営業時間: ' + shop.opening_hours : ''}
        `;
        
        const marker = L.marker([shop.latitude, shop.longitude])
          .addTo(map)
          .bindPopup(popupContent);
        
        markers.push(marker);
      }
    });

    if (markers.length > 0) {
      const group = new L.featureGroup(markers);
      map.fitBounds(group.getBounds().pad(0.1));
    } else {
      map.setView([defaultLat, defaultLng], 11);
    }

    setTimeout(function() {
      map.invalidateSize();
    }, 100);
  }

  document.addEventListener('DOMContentLoaded', initMap);
  document.addEventListener('turbo:load', initMap);

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initMap();
  }
</script>