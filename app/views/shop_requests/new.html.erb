<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h2 class="card-title text-center mb-4">情報提供リクエスト</h2>
          <p class="text-muted text-center mb-4">
            店舗の新規掲載、情報の修正、閉業のご報告などはこちらから送信してください。
          </p>

          <%= form_with(model: @shop_request, local: true) do |f| %>
            <!-- バриデーションエラー表示 -->
            <% if @shop_request.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @shop_request.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- リクエスト種別 -->
            <div class="mb-3">
              <%= f.label :request_type, "リクエスト種別", class: "form-label fw-bold" %>
              <!-- ※データベースの定義やenumに合わせてキーを変更してください -->
              <%= f.select :request_type, 
                  [["新規掲載", "new_shop"], ["情報修正", "update_info"], ["閉業報告", "closed"]], 
                  { prompt: "選択してください" }, 
                  { class: "form-select", required: true } %>
            </div>

            <!-- 店舗名 -->
            <div class="mb-3">
              <%= f.label :shop_name, "店舗名", class: "form-label fw-bold" %>
              <%= f.text_field :shop_name, class: "form-control", placeholder: "例：ペットコインランドリー〇〇店" %>
            </div>

            <!-- 住所 -->
            <div class="mb-3">
              <%= f.label :address, "住所", class: "form-label fw-bold" %>
              <%= f.text_field :address, class: "form-control", placeholder: "例：福岡県福岡市..." %>
            </div>

            <!-- 詳細内容 -->
            <div class="mb-4">
              <%= f.label :body, "詳細内容・修正内容", class: "form-label fw-bold" %>
              <%= f.text_area :body, rows: 5, class: "form-control", placeholder: "修正する箇所や詳しい情報をご記入ください" %>
            </div>

            <!-- 送信ボタン -->
            <div class="d-grid">
              <%= f.submit "送信する", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>