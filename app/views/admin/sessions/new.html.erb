<%# frozen_string_literal: true %>

<div style="background-color: #f3f4f6; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px; width: 100%;">
  <div style="max-width: 440px; width: 100%;">
    
    <!-- カードコンテナ -->
    <div style="background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); padding: 40px;">
      
      <!-- ヘッダー -->
      <div style="text-align: center; margin-bottom: 32px;">
        <h1 style="font-size: 24px; font-weight: bold; color: #1f2937; margin-bottom: 8px;">管理者ログイン</h1>
        <p style="font-size: 14px; color: #6b7280; margin: 0;">管理画面にアクセスしてください。</p>
      </div>

      <!-- フォーム -->
      <%= form_with url: { controller: 'admin/sessions', action: 'create' }, local: true do |f| %>
        
        <!-- メールアドレス -->
        <div style="margin-bottom: 24px;">
          <%= f.label :email, "メールアドレス", style: "display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@domain.com", style: "width: 100%; border: 1px solid #d1d5db; border-radius: 6px; padding: 10px 12px; font-size: 15px; background: #fff; outline: none; box-sizing: border-box;" %>
        </div>

        <!-- パスワード -->
        <div style="margin-bottom: 32px;">
          <%= f.label :password, "パスワード", style: "display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px;" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", style: "width: 100%; border: 1px solid #d1d5db; border-radius: 6px; padding: 10px 12px; font-size: 15px; background: #fff; outline: none; box-sizing: border-box;" %>
        </div>

        <!-- 送信ボタン -->
        <div>
          <%= f.submit "ログイン", style: "width: 100%; background-color: #4f46e5; color: #ffffff; font-weight: 600; padding: 12px 0; border: none; border-radius: 6px; font-size: 15px; cursor: pointer; text-align: center;" %>
        </div>
      <% end %>

    </div>
    
  </div>
</div>